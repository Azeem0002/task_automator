[Unit]
Description=Task Automator health monitor worker
After=network.target

[Service]
Type=simple
# Module execution preserves package-relative imports. Replace paths for the
# target machine; do not use an ambiguous global `health-worker` executable.
WorkingDirectory=/home/az/task_automator
ExecStart=/home/az/task_automator/.venv/bin/python -m task_automator.workers.disk_health_monitor --path /home --interval 60s --minimum-free-gb 1
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
